# ==============================================================================
# ROTAYD MÜKELLEF PORTALI - ORTAM DEĞİŞKENLERİ (ENV TEMPLATE)
# ==============================================================================

# NextAuth Konfigürasyonu
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=rotayd_super_secure_nextauth_jwt_secret_key_2026

# Google Cloud OAuth 2.0 Bilgileri
# 1. https://console.cloud.google.com adresine gidin.
# 2. "APIs & Services" > "Credentials" > "Create Credentials" > "OAuth client ID" seçin.
# 3. Application Type: "Web application"
# 4. Authorized redirect URIs bölümüne:
#    - Yerel test için: http://localhost:3000/api/auth/callback/google
#    - Canlı alan adı için: https://rotayd.com/api/auth/callback/google
# 5. Oluşturulan Client ID ve Client Secret değerlerini aşağıya yapıştırın:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sistem Mali Müşavir / Admin E-Postaları (Virgülle ayırarak birden fazla eklenebilir)
# Bu e-postalarla Google girişi yapıldığında hesap otomatik olarak ADMIN ve APPROVED olur.
ADMIN_EMAILS=suleyman@rotayd.com
